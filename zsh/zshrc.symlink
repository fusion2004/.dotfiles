# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block, everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# shortcut to this dotfiles path is $DOTFILES
export DOTFILES=$HOME/.dotfiles

# i don't know why i needed this, and now it breaks things
# export LANG=en_US.UTF8
export EDITOR="nvim"
export GUIEDITOR="zed"
export MISE_ENV=development

HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000
# setopt share_history

function is_macos() {
  [[ $OSTYPE == darwin* ]]
}

# ensure the start of the ssh-agent by the ohmyzsh plugin doesn't output
# any messages to the console during p10k startup
zstyle :omz:plugins:ssh-agent quiet yes

# load antidote
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
source "${DOTFILES}/zsh/.zsh_plugins.sh"

# all of our zsh files
typeset -U config_files
config_files=($DOTFILES/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/_path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/_path.zsh}:#*/completion.zsh}
do
  source $file
done

unset config_files

source $HOME/.config/broot/launcher/bash/br

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
# [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
# source $DOTFILES/zsh/p10k.zsh

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init --path)"

export FNOX_AGE_KEY_FILE=~/.config/fnox/age.txt
eval "$(fnox activate zsh)"

# This is local to each computer, but needs to set:
# - JIRA_BASE_URL: the base url/path for the relevant Jira instance (without a trailing /)
[[ -f "$HOME/.zsh_fusion_config" ]] && source ~/.zsh_fusion_config

ulimit -n 1024

if [[ -f "$HOME/.glrc" ]]; then
  source $HOME/.glrc
fi
